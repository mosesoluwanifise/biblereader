# Dependencies
node_modules/

# Build output
dist/
dist-ssr/
*.local

# Scratch renders. Nothing in the repo writes here — make-thumbnail.ps1 emits
# beside itself in docs/marketing/ — so this is a catch-all for exported
# variants that should not be versioned.
output/

# Generated model assets (~138 MB, produced by scripts/build-model-assets.mjs)
# Bible text under public/bibles/ IS committed — see KTD2 in the V1 plan.
public/models/

# Test artifacts
coverage/
playwright-report/
test-results/
.playwright/

# Harness worktrees. Both locations: .worktrees/ holds a full checkout
# including node_modules (~360 MB), so leaving it untracked put that one
# `git add -A` away from being staged.
.claude/worktrees/
.worktrees/

# Environment
.env
.env.*
!.env.example

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.swp

# Logs
*.log
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python (backend removed in V1 — guard against strays)
__pycache__/
*.py[cod]
.venv/
venv/

# Spike model downloads (~380 MB, re-fetchable from Hugging Face)
spikes/**/models/

# Spike audio output
spikes/**/*.wav

# Cloudflare Wrangler local state (wrangler pages dev, local R2 emulation)
.wrangler/
