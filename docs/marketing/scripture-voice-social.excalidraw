      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "WebAssembly lets compiled code run in the browser at nearly\nnative speed. \"Threads\" means splitting that work across\nseveral CPU cores instead of piling it all onto one.",
      "originalText": "WebAssembly lets compiled code run in the browser at nearly\nnative speed. \"Threads\" means splitting that work across\nseveral CPU cores instead of piling it all onto one.",
