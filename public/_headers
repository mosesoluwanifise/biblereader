# Cloudflare Pages custom headers. Only applies to static assets served
# directly by Pages — responses from functions/ set their own headers,
# since Pages does not apply this file to Function output.
#
# Mirrors the dev/preview headers in vite.config.ts. Without these,
# crossOriginIsolated is false, SharedArrayBuffer is unavailable, and
# onnxruntime-web silently drops to a single WASM thread — measured at
# roughly 1.3x slower for this model. See src/services/tts/synthesis.worker.ts.
/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp

# Bible text is regenerated by scripts/build-bible-data.mjs and redeployed
# whole; nothing references it by a content hash. Cache long, and the
# client-side manifest check (src/services/bible/bibleService.ts) still
# invalidates IndexedDB when the version changes — but the manifest itself
# must stay fresh so that check can fire promptly.
/bibles/manifest.json
  Cache-Control: public, max-age=60, must-revalidate

/bibles/*
  Cache-Control: public, max-age=604800, must-revalidate
